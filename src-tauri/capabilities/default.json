{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions used by the Video Hub App Tauri compatibility bridge",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-clear-all-browsing-data",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path"
  ]
}
